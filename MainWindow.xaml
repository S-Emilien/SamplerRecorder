<Window x:Class="SamplerRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SamplerRecorder.Controls"
        xmlns:vm="clr-namespace:SamplerRecorder.ViewModels"
        mc:Ignorable="d"
        Title="SamplerRecorder" Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar: Recording Controls -->
        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="10,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Left: App title -->
                <TextBlock DockPanel.Dock="Left" Text="SamplerRecorder" FontWeight="Bold"
                           FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="{StaticResource AccentBrush}"/>

                <!-- Right: Status -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="11"/>

                <!-- Center: Recording controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Source selection -->
                    <CheckBox Content="Mic" IsChecked="{Binding RecordMic}" Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding MicDevices}" SelectedItem="{Binding SelectedMicDevice}"
                              Width="140" Margin="0,0,12,0" IsEnabled="{Binding RecordMic}"/>

                    <CheckBox Content="System" IsChecked="{Binding RecordSystemAudio}" Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding SystemDevices}" SelectedItem="{Binding SelectedSystemDevice}"
                              Width="140" Margin="0,0,16,0" IsEnabled="{Binding RecordSystemAudio}"/>

                    <Separator Margin="4,0,12,0"/>

                    <!-- Record buttons -->
                    <Button Content="&#x23FA; Record" Command="{Binding StartRecordingCommand}"
                            Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                            ToolTip="Ctrl+Shift+R"/>
                    <Button Content="&#x23F8; Pause" Command="{Binding PauseRecordingCommand}"
                            Margin="0,0,6,0" ToolTip="Ctrl+Shift+P"/>
                    <Button Content="&#x23F9; Stop" Command="{Binding StopRecordingCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                            ToolTip="Ctrl+Shift+S"/>
                    <Button Content="&#x2691; Marker" Command="{Binding CreateMarkerCommand}"
                            Margin="0,0,6,0" ToolTip="Ctrl+Shift+M"/>
                    <Button Content="&#x1F4BE; Save" Command="{Binding SaveSessionCommand}"
                            Margin="0,0,6,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Second row: Playback + Timer -->
        <Border Grid.Row="1" Background="{StaticResource BgMediumBrush}" Padding="10,5"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Timer -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding ElapsedTime}" FontSize="18"
                           FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,16,0"/>

                <!-- Peak meter -->
                <Grid DockPanel.Dock="Left" Width="100" Height="12" Margin="0,0,16,0"
                      VerticalAlignment="Center">
                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="3"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                            HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="CurrentPeak"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>

                <!-- Right: Playback speed -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <Button Content="1x" Command="{Binding SetPlaybackSpeedCommand}"
                            CommandParameter="1.0" Padding="6,3" Margin="0,0,3,0"/>
                    <Button Content="1.5x" Command="{Binding SetPlaybackSpeedCommand}"
                            CommandParameter="1.5" Padding="6,3" Margin="0,0,3,0"/>
                    <Button Content="2x" Command="{Binding SetPlaybackSpeedCommand}"
                            CommandParameter="2.0" Padding="6,3"/>
                </StackPanel>

                <!-- Center: Playback controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&#x23EE;" Command="{Binding PreviousMarkerCommand}"
                            Padding="8,4" Margin="0,0,4,0" ToolTip="Previous Marker"/>
                    <Button Content="&#x25B6; Play" Command="{Binding PlayCommand}"
                            Padding="10,4" Margin="0,0,4,0"/>
                    <Button Content="&#x23F9;" Command="{Binding StopPlaybackCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="&#x23ED;" Command="{Binding NextMarkerCommand}"
                            Padding="8,4" ToolTip="Next Marker"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Center: Waveform -->
        <Border Grid.Row="2" Margin="6" CornerRadius="4" ClipToBounds="True"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <controls:WaveformControl x:Name="WaveformDisplay"/>
        </Border>

        <!-- Bottom: Clips + Markers -->
        <Grid Grid.Row="3" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Clip List -->
            <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" CornerRadius="4"
                    Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Clips" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="+ Create Clip" Command="{Binding CreateClipCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                        <Button Content="Export" Command="{Binding ExportClipCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                        <Button Content="Export All" Command="{Binding ExportAllClipsCommand}"
                                Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                        <Button Content="Delete" Command="{Binding DeleteClipCommand}"
                                Padding="8,3" FontSize="11"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}"
                             BorderThickness="0" Background="Transparent" MaxHeight="130">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}" FontSize="12"
                                             VerticalContentAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Spacer -->
            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Marker List -->
            <Border Grid.Column="2" Background="{StaticResource BgMediumBrush}" CornerRadius="4"
                    Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Markers" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Markers}" BorderThickness="0"
                             Background="Transparent" MaxHeight="130">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{StaticResource WarningBrush}"
                                               FontSize="11" FontFamily="Consolas"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding TimestampMs, StringFormat={}{0}ms, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,3"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="Marker_Click"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource BgMediumBrush}" Padding="8,4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextDimBrush}" FontSize="11">
                    <Run Text="Selection: "/>
                    <Run Text="{Binding SelectionStart, Mode=OneWay, StringFormat={}{0}ms}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding SelectionEnd, Mode=OneWay, StringFormat={}{0}ms}"/>
                </TextBlock>
                <TextBlock Text="Shift+Drag to select region | Scroll to zoom | Drag to pan | Click to seek"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
