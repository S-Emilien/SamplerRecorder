<Window x:Class="SamplerRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SamplerRecorder.Controls"
        xmlns:vm="clr-namespace:SamplerRecorder.ViewModels"
        xmlns:conv="clr-namespace:SamplerRecorder.Converters"
        mc:Ignorable="d"
        Title="SamplerRecorder" Height="720" Width="1150"
        MinHeight="500" MinWidth="800"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:PeakToWidthConverter x:Key="PeakToWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <!-- ==================== HOME SCREEN ==================== -->
        <Grid x:Name="HomeScreen" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="12,10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="SamplerRecorder" FontWeight="Bold"
                               FontSize="16" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>

                    <!-- Recording indicator -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0"
                                Visibility="{Binding IsRecordingActive, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="RECORDING" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="{StaticResource DangerBrush}"
                                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               FontSize="11" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Recording Controls Bar -->
            <Border Grid.Row="1" Background="{StaticResource BgMediumBrush}" Padding="12,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Output:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <ComboBox ItemsSource="{Binding SystemDevices}" SelectedItem="{Binding SelectedSystemDevice}"
                              Width="200" Margin="0,0,20,0"/>

                    <Separator Margin="4,0,16,0"/>

                    <Button Content="&#x23FA; Record" Command="{Binding StartRecordingCommand}"
                            Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                            IsEnabled="{Binding CanStartRecording}"/>
                    <Button Content="&#x23F8; Pause" Command="{Binding PauseRecordingCommand}"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding CanPauseRecording}"/>
                    <Button Content="&#x23F9; Stop" Command="{Binding StopRecordingCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                            IsEnabled="{Binding CanStopRecording}"/>
                    <Button Content="&#x2691; Marker" Command="{Binding CreateMarkerCommand}"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding CanCreateMarker}"/>
                </StackPanel>
            </Border>

            <!-- Recording Options -->
            <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="12,5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox Content="Start on sound" IsChecked="{Binding StartOnSound}"
                              VerticalAlignment="Center" Margin="0,0,20,0"
                              IsEnabled="{Binding CanStartRecording}"/>

                    <CheckBox Content="Skip silence after" IsChecked="{Binding StopOnSilence}"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              IsEnabled="{Binding CanStartRecording}"/>
                    <TextBox Text="{Binding SilenceTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" VerticalAlignment="Center" TextAlignment="Center"
                             IsEnabled="{Binding StopOnSilence}"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Main Content: Recordings + Clips -->
            <Grid Grid.Row="3" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recordings List -->
                <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" CornerRadius="6"
                        Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Recordings" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="&#x21BB;" Command="{Binding RefreshRecordingsCommand}"
                                        Padding="0" Width="22" Height="22" FontSize="12"
                                        ToolTip="Refresh" VerticalAlignment="Center"/>
                                <Button Content="&#x1F4C2; Open Folder" Command="{Binding OpenRecordingsFolderCommand}"
                                        Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="RecordingsList" ItemsSource="{Binding SavedSessions}"
                                 BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="RecordingsList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="&#x1F4DD;" Command="{Binding DataContext.EditSessionNoteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="0"
                                                    Width="22" Height="22" FontSize="11" ToolTip="Edit Note"
                                                    VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding DurationText}"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       FontFamily="Consolas" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DateText}" FontSize="10"
                                                           Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding Note}" FontSize="10"
                                                           Foreground="#FFD700" Margin="14,0,0,0"
                                                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- All Clips List -->
                <Border Grid.Column="2" Background="{StaticResource BgMediumBrush}" CornerRadius="6"
                        Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="All Clips" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="&#x1F50A;" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,4,0"/>
                                <Slider Value="{Binding PlaybackVolume}" Minimum="0" Maximum="1"
                                        Width="80" VerticalAlignment="Center" Margin="0,0,10,0"
                                        ToolTip="Playback Volume"/>
                                <Button Content="&#x21BB;" Command="{Binding RefreshClipsCommand}"
                                        Padding="0" Width="22" Height="22" FontSize="12"
                                        ToolTip="Refresh" VerticalAlignment="Center"/>
                                <Button Content="&#x1F4C2; Open Folder" Command="{Binding OpenClipsFolderCommand}"
                                        Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding AllClips}" BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,3">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Command="{Binding DataContext.PlayClipFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="0" Margin="0,0,3,0"
                                                    Width="24" Height="24" ToolTip="Play/Pause">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="&#x25B6;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Content" Value="&#x23F8;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="&#x23F9;" Command="{Binding DataContext.StopClipFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="0"
                                                    Width="24" Height="24" ToolTip="Stop"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="4" Background="{StaticResource BgMediumBrush}" Padding="10,5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="SettingsButton_Click"
                            ToolTip="Hotkey Settings" Cursor="Hand" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Padding="4,1"
                            FontSize="11" Foreground="{StaticResource TextDimBrush}"
                            Content="&#x2699;" Margin="10,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppCopyright, Mode=OneTime}"
                               Foreground="{StaticResource TextDimBrush}" FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Double-click a recording to open the editor | Hotkeys work globally"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== EDITOR SCREEN ==================== -->
        <Grid x:Name="EditorScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Editor Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="10,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="&#x2190; Back" Click="BackToHome_Click"
                            Padding="10,5" Margin="0,0,16,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding EditorTitle}" FontWeight="SemiBold"
                               FontSize="14" VerticalAlignment="Center"/>

                    <!-- Recording indicator in editor -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding IsRecordingActive, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="REC" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="{StaticResource DangerBrush}"
                                   FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               Margin="24,0,16,0" FontSize="11"/>
                </DockPanel>
            </Border>

            <!-- Playback + Timer Bar -->
            <Border Grid.Row="1" Background="{StaticResource BgMediumBrush}" Padding="10,5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PlaybackPositionText}" FontSize="18"
                               FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,0,16,0"/>

                    <!-- Playback volume (shared with home screen) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F50A;" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,0,4,0"/>
                        <Slider Value="{Binding PlaybackVolume}" Minimum="0" Maximum="1"
                                Width="90" VerticalAlignment="Center"
                                ToolTip="Playback Volume"/>
                    </StackPanel>

                    <!-- Playback controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="&#x23EE;" Command="{Binding PreviousMarkerCommand}"
                                Padding="8,4" Margin="0,0,4,0" ToolTip="Previous Marker"/>
                        <Button Command="{Binding PlayCommand}" Padding="10,4" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#x25B6; Play"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                            <Setter Property="Content" Value="&#x23F8; Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#x23F9;" Command="{Binding StopPlaybackCommand}"
                                Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="&#x23ED;" Command="{Binding NextMarkerCommand}"
                                Padding="8,4" ToolTip="Next Marker"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Waveform -->
            <Border Grid.Row="2" Margin="8,6" CornerRadius="4" ClipToBounds="True"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <controls:WaveformControl x:Name="WaveformDisplay"/>
            </Border>

            <!-- Selection Info -->
            <Border Grid.Row="3" Background="{StaticResource BgMediumBrush}" Padding="10,6" Margin="8,0"
                    CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selection times -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="In: " Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectionStartText}" FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Out: " Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectionEndText}" FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Len: " Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectionLengthText}" FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Play selection + Create clip (true center) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="&#x25B6; Play Selection" Command="{Binding PlaySelectionCommand}"
                                Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="+ Create Clip from Selection" Command="{Binding CreateClipCommand}"
                                Style="{StaticResource AccentButton}" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Clips + Markers -->
            <Grid Grid.Row="4" Margin="8,6,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Clip List -->
                <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" CornerRadius="4"
                        Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Clips" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Export All" Command="{Binding ExportAllClipsCommand}"
                                    Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                            <Button Content="&#x1F4C2; Open Folder" Command="{Binding OpenClipsFolderCommand}"
                                    Padding="8,3" FontSize="11"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}"
                                 BorderThickness="0" Background="Transparent" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                                    <DockPanel>
                                        <!-- Inline action buttons -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                            <TextBlock Text="&#x2713;" Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding IsExported, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Exported"/>
                                            <Button Command="{Binding DataContext.PlayEditorClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="0" Margin="0,0,3,0"
                                                    Width="24" Height="22" ToolTip="Play/Pause">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="&#x25B6;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Content" Value="&#x23F8;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="&#x23F9;" Command="{Binding DataContext.StopEditorClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="0" Margin="0,0,3,0"
                                                    Width="24" Height="22" ToolTip="Stop"/>
                                            <Button Content="&#x1F4E4;" Command="{Binding DataContext.ExportClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="4,2" Margin="0,0,3,0"
                                                    FontSize="11" Width="26" Height="22" ToolTip="Export"/>
                                            <Button Content="&#x2715;" Command="{Binding DataContext.DeleteClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Padding="4,2"
                                                    FontSize="11" Width="26" Height="22" ToolTip="Delete"/>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}" FontSize="12"
                                                 VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Marker List -->
                <Border Grid.Column="2" Background="{StaticResource BgMediumBrush}" CornerRadius="4"
                        Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Markers" FontWeight="SemiBold"
                                   FontSize="13" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Markers}" BorderThickness="0"
                                 Background="Transparent" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Text="{Binding TimestampText}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,3"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="Marker_Click"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Editor Status Bar -->
            <Border Grid.Row="5" Background="{StaticResource BgMediumBrush}" Padding="8,4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="Left-click: seek | Left-drag: pan | Right-drag: select region | Drag edges to resize | Scroll to zoom"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
            </Border>
        </Grid>

        <!-- ==================== SETTINGS SCREEN ==================== -->
        <Grid x:Name="SettingsScreen" Visibility="Collapsed" Background="{StaticResource BgDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Settings Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="10,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="&#x2190; Back" Click="BackToHome_FromSettings_Click"
                            Padding="10,5" Margin="0,0,16,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="Settings" FontWeight="SemiBold"
                               FontSize="14" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <!-- Folders Section -->
                    <TextBlock Text="Folders" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                    <TextBlock Text="Choose where exported clips and recording sessions are stored. Leave unchanged to use default locations."
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Exports folder -->
                    <TextBlock Text="Exports folder (clips)" FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding ChangeExportFolderCommand}"
                                Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ExportFolderPath, Mode=OneWay}" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="6,5"
                                 Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    </DockPanel>

                    <!-- Working directory -->
                    <TextBlock Text="Working directory (recordings)" FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding ChangeWorkingDirectoryCommand}"
                                Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding WorkingDirectoryPath, Mode=OneWay}" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Padding="6,5"
                                 Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    </DockPanel>
                    <TextBlock Text="Default: %AppData%\SamplerRecorder"
                               Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,0,0,24"/>

                    <!-- Hotkeys Section -->
                    <TextBlock Text="Global Hotkeys" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
                    <TextBlock Text="Click Assign and press the desired key combination or mouse button. Hotkeys work globally, even when the app is not focused."
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Hotkey rows -->
                    <controls:HotkeyCaptureControl x:Name="HotkeyStart" ActionName="Start Recording"
                                                   BindingDisplay="{Binding StartRecordingHotkeyText, Mode=OneWay}"
                                                   Margin="0,0,0,10"/>
                    <controls:HotkeyCaptureControl x:Name="HotkeyPause" ActionName="Pause Recording"
                                                   BindingDisplay="{Binding PauseRecordingHotkeyText, Mode=OneWay}"
                                                   Margin="0,0,0,10"/>
                    <controls:HotkeyCaptureControl x:Name="HotkeyStop" ActionName="Stop Recording"
                                                   BindingDisplay="{Binding StopRecordingHotkeyText, Mode=OneWay}"
                                                   Margin="0,0,0,10"/>
                    <controls:HotkeyCaptureControl x:Name="HotkeyMarker" ActionName="Create Marker"
                                                   BindingDisplay="{Binding CreateMarkerHotkeyText, Mode=OneWay}"
                                                   Margin="0,0,0,10"/>

                    <!-- Validation error -->
                    <TextBlock Text="{Binding HotkeyValidationError}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasHotkeyValidationError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
